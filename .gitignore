# Source-only repository: new file types require an explicit allow rule.
*
!/.gitignore
!/.gitattributes
!/LICENSE
!/README.md
!/README.zh-CN.md
!/SECURITY.md
!/CONTRIBUTING.md
!/THIRD_PARTY_NOTICES.md
!/build.sh
!/Sources/
!/Sources/**/
!/Sources/**/*.swift
!/Sources/**/*.plist
!/Resources/
!/Resources/*.js
!/Resources/*.cjs
!/Resources/*LICENSE.txt
!/Resources/mihomo-provenance.json
!/Resources/Brand/
!/Resources/Brand/ccmiss-logo.png
!/Tools/
!/Tools/*.sh
!/Tools/*.swift
!/Tools/*.py
!/Tools/dependencies.json
!/docs/
!/docs/*.md
!/.github/
!/.github/**/
!/.github/**/*.yml
!/.github/**/*.md
# Personal data and build outputs remain excluded even inside source folders.
**/.DS_Store
**/.env
**/.env.*
**/*credentials*
**/*handoff*
**/*backup*
**/*private*
**/profiles.json
**/state.json
**/settings.local.json
**/*.log
**/*.jsonl
**/*.app/
**/*.dmg
**/*.zip
**/*.tar.gz
**/*.p12
**/*.pfx
**/*.key
/.build/
/.deps/
/dist/
/outputs/
